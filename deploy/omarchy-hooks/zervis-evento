#!/bin/bash
# Hook do Omarchy instalado pelo Zé (docs/07-sistema-omarchy.md, Fase 5).
# Só anota o evento para o Zé ler; não usa rede nem roda mais nada.
# O nome do evento vem da pasta onde ele foi instalado (battery-low.d, post-update.d...).
evento="$(basename "$(dirname "$0")" .d)"
destino="${XDG_STATE_HOME:-$HOME/.local/state}/zervis/eventos-sistema.jsonl"
mkdir -p "$(dirname "$destino")"
arg="$(printf '%s' "${1:-}" | tr -cd '[:alnum:] ._-' | cut -c1-80)"
printf '{"evento":"%s","arg":"%s","ts":%s}\n' "$evento" "$arg" "$(date +%s)" >> "$destino"
