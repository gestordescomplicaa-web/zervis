<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/toque">
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/acento_escuro" />
                    <stroke android:width="1dp" android:color="@color/borda_forte" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
