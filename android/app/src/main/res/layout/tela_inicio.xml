<?xml version="1.0" encoding="utf-8"?>
<!-- Início: o Zé no centro com o estado em volta, o modo de ouvir e o botão de falar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_tela"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ze_logo" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/nome"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/ajustes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/botao_icone"
                android:contentDescription="@string/ajustes"
                android:src="@drawable/ic_ajustes"
                android:tint="@color/texto" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/ponto"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/ponto" />

                <TextView
                    android:id="@+id/conexao"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/endereco"
                style="@style/Texto.Pequeno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.zervis.voz.Orbe
                android:id="@+id/orbe"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/estado"
                style="@style/Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textFontWeight="600"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/dica"
                style="@style/Texto.Suave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:minHeight="44dp"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/saidaIcone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alto_falante"
                android:tint="@color/suave" />

            <TextView
                android:id="@+id/saida"
                style="@style/Texto.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                android:tint="@color/suave" />

            <TextView
                android:id="@+id/microfone"
                style="@style/Texto.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Segmentado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/modoChamado"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/modo_chamado" />

            <Button
                android:id="@+id/modoAoVivo"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/modo_ao_vivo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/falar"
            style="@style/Botao.Principal"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/falarIcone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                android:tint="@color/sobre_acento" />

            <TextView
                android:id="@+id/falarTexto"
                style="@style/TextoDoBotao.Principal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
