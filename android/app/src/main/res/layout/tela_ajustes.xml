<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes: a escuta de perto, o áudio, o app (atualização) e a conexão. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_tela"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/voltar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="-10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voltar"
                    android:src="@drawable/ic_voltar"
                    android:tint="@color/texto" />

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes" />
            </LinearLayout>

            <!-- Escuta de perto -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/CabecalhoDoCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView style="@style/IconeDoCartao" android:src="@drawable/ic_orelha" />

                    <Switch
                        android:id="@+id/perto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:switchMinWidth="56dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/perto"
                        android:textColor="@color/texto"
                        android:textFontWeight="600"
                        android:textSize="16sp"
                        android:thumb="@drawable/interruptor_bolinha"
                        android:track="@drawable/interruptor_trilha" />
                </LinearLayout>

                <TextView
                    style="@style/Texto.Suave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/perto_descricao" />

                <LinearLayout
                    android:id="@+id/pertoBloco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Pequeno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/nivel" />

                        <TextView
                            android:id="@+id/leitura"
                            style="@style/Texto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.zervis.voz.Medidor
                        android:id="@+id/medidor"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        style="@style/Texto.Pequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/minimo"
                        android:text="@string/minimo" />

                    <SeekBar
                        android:id="@+id/minimo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="-14dp"
                        android:layout_marginEnd="-14dp"
                        android:progressBackgroundTint="@color/borda_forte"
                        android:progressTint="@color/acento"
                        android:thumbTint="@color/acento" />

                    <TextView
                        style="@style/Texto.Pequeno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/minimo_dica" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pertoComFone"
                    style="@style/Texto.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/perto_com_fone"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Áudio -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/CabecalhoDoCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView style="@style/IconeDoCartao" android:src="@drawable/ic_fone" />

                    <TextView
                        style="@style/Texto.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/audio" />
                </LinearLayout>

                <TextView
                    android:id="@+id/audioRotulo"
                    style="@style/Texto.Pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/audioOpcoes"
                    style="@style/Segmentado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/audioA"
                        style="@style/Segmento"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/audioB"
                        style="@style/Segmento"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/audioNota"
                    style="@style/Texto.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- App -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/CabecalhoDoCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView style="@style/IconeDoCartao" android:src="@drawable/ic_celular" />

                    <TextView
                        style="@style/Texto.Secao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/app" />

                    <TextView
                        android:id="@+id/versao"
                        style="@style/Texto.Pequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/atualizar"
                    style="@style/Botao.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:id="@+id/atualizarIcone"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_atualizar"
                        android:tint="@color/texto" />

                    <TextView
                        android:id="@+id/atualizarTexto"
                        style="@style/TextoDoBotao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/atualizarMensagem"
                    style="@style/Texto.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Conexão -->
            <LinearLayout
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/CabecalhoDoCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView style="@style/IconeDoCartao" android:src="@drawable/ic_conexao" />

                    <TextView
                        style="@style/Texto.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/conexao" />

                    <TextView
                        android:id="@+id/enderecoAjustes"
                        style="@style/Texto.Pequeno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/desconectar"
                    style="@style/Botao.Perigo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_desligar"
                        android:tint="@color/erro" />

                    <TextView
                        style="@style/TextoDoBotao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/desconectar"
                        android:textColor="@color/erro" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
