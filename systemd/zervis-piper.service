[Unit]
Description=Zé: voz Cadu pelo Piper (servidor HTTP do próprio Piper, só em loopback)
# Piper (piper-tts 1.4.2) é GPL-3.0: roda como programa separado e o jarvisd só fala com ele por
# HTTP (ADR 0012). Instalação: uv tool install piper-tts==1.4.2 --with flask==3.1.3
#   --with onnxruntime==1.30.0; voz pt_BR-cadu-medium (CC0) em ~/.local/share/zervis/vozes,
#   conferida por sha256 (docs/adr/0012-voz-piper-e-escuta-deepgram.md).

[Service]
Type=simple
ExecStart=%h/.local/share/uv/tools/piper-tts/bin/python -m piper.http_server --host 127.0.0.1 --port 17871 -m %h/.local/share/zervis/vozes/pt_BR-cadu-medium.onnx --data-dir %h/.local/share/zervis/vozes
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
